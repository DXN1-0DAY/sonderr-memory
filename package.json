{
  "name": "sonderr-memory",
  "version": "0.0.16",
  "private": true,
  "type": "module",
  "description": "Local-first, file-backed context engine for AI coding agents.",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "bun run src/main.ts",
    "dev:cli": "bun run src/cli.ts",
    "build": "bun build ./src/main.ts --target bun --compile --outfile ./dist/sonderr-memory && mv ./dist/sonderr-memory ./dist/sonderr-memory-linux-x64",
    "build:cli": "bun build ./src/cli.ts --target bun --compile --outfile ./dist/sonderr-memory-cli && mv ./dist/sonderr-memory-cli ./dist/sonderr-memory-cli-linux-x64",
    "lint": "oxlint",
    "typecheck": "bun x tsc --noEmit"
  },
  "bin": {
    "sonderr-memory": "./src/main.ts"
  },
  "workspaces": [],
  "dependencies": {
    "blessed": "^0.1.81",
    "chalk": "^5.4.1"
  },
  "devDependencies": {
    "@types/blessed": "^0.1.25",
    "@types/bun": "1.3.14",
    "typescript": "5.8.2",
    "oxlint": "1.60.0"
  }
}
