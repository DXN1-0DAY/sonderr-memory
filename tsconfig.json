{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "outDir": "dist",
    "baseUrl": ".",
    "allowImportingTsExtensions": true,
    "paths": {
      "blessed": ["./node_modules/@types/blessed"]
    },
    "lib": ["ES2022"]
  },
  "include": ["src"]
}
